{
    // Theme
    "workbench.colorTheme": "Tokyo Night",
    "workbench.iconTheme": "material-icon-theme",

    // Font
    "editor.fontFamily": "'CaskaydiaCove Nerd Font', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,

    // Smooth feel
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,

    // Clean look
    "editor.minimap.enabled": false,
    "editor.padding.top": 12,
    "editor.renderLineHighlight": "all",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",

    // Integrated terminal
    "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    // Transparency (Vibrancy)
    "vscode_vibrancy.type": "acrylic",
    "vscode_vibrancy.opacity": 0.95,
    "vscode_vibrancy.theme": "Tokyo Night Storm",
    "workbench.colorCustomizations": {
        "terminal.background": "#00000000",
        "editorPane.background": "#1a1b2600",
        "editorGroupHeader.tabsBackground": "#1a1b2600",
        "editorGroupHeader.noTabsBackground": "#1a1b2600",
        "breadcrumb.background": "#1a1b2600",
        "editorGutter.background": "#1a1b2600",
        "panel.background": "#1a1b2600",
        "tab.activeBackground": "#1a1b2600",
        "tab.unfocusedActiveBackground": "#1a1b2600",
        "sideBar.background": "#1a1b26f2",
        "sideBarTitle.background": "#1a1b26f2",
        "activityBar.background": "#1a1b26f2",
        "editor.background": "#1a1b26f2",
        "tab.inactiveBackground": "#1a1b26f2",
        "tab.unfocusedInactiveBackground": "#1a1b26f2",
        "editorStickyScroll.background": "#1a1b26f2",
        "editorStickyScrollGutter.background": "#1a1b26f2",
        "sideBarStickyScroll.background": "#1a1b26f2",
        "panelStickyScroll.background": "#1a1b26f2",
        "terminalStickyScroll.background": "#1a1b26f2",
        "minimap.background": "#1a1b26f2",
        "inlineChat.background": "#1a1b26e6",
        "editorWidget.background": "#1a1b26e6",
        "editorHoverWidget.background": "#1a1b26e6",
        "editorSuggestWidget.background": "#1a1b26e6",
        "notifications.background": "#1a1b26e6",
        "notificationCenterHeader.background": "#1a1b26e6",
        "menu.background": "#1a1b26e6",
        "quickInput.background": "#1a1b26e6",
        "editor.lineHighlightBorder": "#00000000"
    },
    "terminal.integrated.gpuAcceleration": "off",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "window.controlsStyle": "custom"
}